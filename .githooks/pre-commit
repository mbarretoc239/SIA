#!/bin/sh
# Bloqueia o commit se algum arquivo .py do projeto tiver uma leitura do
# Supabase que pode vir cortada (ver scripts/checar_paginacao.py e a
# memória "feedback_paginacao_supabase" -- o PostgREST corta respostas em
# 1000 linhas por padrao, silenciosamente, e isso ja causou bug real em
# producao mais de uma vez nesta sessao: confirmacao de ciencia "sumindo",
# guia marcada como vista reaparecendo como pendente).
#
# Roda em QUALQUER commit que mude algum .py -- nao so shared/database.py,
# porque o bug ja escapou por um arquivo diferente (core/amostragem.py
# batendo no Supabase direto, por fora do DatabaseManager).

if git diff --cached --name-only | grep -q '\.py$'; then
    python scripts/checar_paginacao.py
    if [ $? -ne 0 ]; then
        echo ""
        echo "Commit bloqueado: veja acima a(s) leitura(s) do Supabase sem protecao de paginacao."
        exit 1
    fi
fi

exit 0
